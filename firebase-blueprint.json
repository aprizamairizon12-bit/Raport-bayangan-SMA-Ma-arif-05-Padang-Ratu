        "teacherName": {
          "type": "string",
          "description": "Name of the assigned teacher",
          "minLength": 1,
          "maxLength": 120
        },
        "subjectId": {
          "type": "string",
          "description": "Assigned Subject document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "className": {
          "type": "string",
          "description": "Assigned Class name (e.g. X 1)",
          "minLength": 1,
          "maxLength": 50
        },
        "academicYear": {
          "type": "string",
          "description": "Academic year (e.g. 2026/2027)",
          "minLength": 1,
          "maxLength": 30
        },
        "semester": {
          "type": "string",
          "description": "Semester (Ganjil or Genap)",
          "enum": ["Ganjil", "Genap"],
          "minLength": 1,
          "maxLength": 20
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the admin who created this assignment",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "teacherUid",
        "teacherName",
        "subjectId",
        "className",
        "academicYear",
        "semester",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AcademicYear": {
