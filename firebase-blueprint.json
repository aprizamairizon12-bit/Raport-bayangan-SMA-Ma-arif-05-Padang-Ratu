        "nisn",
        "name",
        "gender",
        "className",
        "sakit",
        "izin",
        "alpa",
        "behaviorPredicate",
        "behaviorNote",
        "homeroomNote",
        "homeroomUid",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
