    "Student": {
      "title": "Student",
      "description": "Represents a student with demographic, attendance, behavior, and homeroom note records.",
      "type": "object",
      "properties": {
        "nisn": {
          "type": "string",
          "description": "Nomor Induk Siswa Nasional",
