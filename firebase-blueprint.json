{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin registry document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Verified email of the administrator",
          "minLength": 3,
          "maxLength": 120
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the admin who granted access",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        }
      },
      "required": ["uid", "email", "createdBy", "createdAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Represents a school staff/teacher user profile and role assignment.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "description": "Full name and academic title of the teacher/admin",
          "minLength": 1,
          "maxLength": 120
        },
        "nip": {
          "type": "string",
          "description": "NIP or NUPTK of the teacher",
          "minLength": 0,
          "maxLength": 50
        },
        "role": {
          "type": "string",
          "description": "Primary system role",
          "enum": ["admin", "teacher", "homeroom", "guru_mapel", "wali_kelas"],
          "minLength": 5,
          "maxLength": 20
        },
        "homeroomClass": {
          "type": "string",
          "description": "Assigned class name if user is a Wali Kelas (or empty string)",
          "minLength": 0,
          "maxLength": 50
        },
        "assignedSubjectIds": {
          "type": "string",
          "description": "Comma-separated subject IDs assigned to this teacher",
          "minLength": 0,
          "maxLength": 500
        },
        "assignedClasses": {
          "type": "string",
          "description": "Comma-separated class names assigned to this teacher",
          "minLength": 0,
          "maxLength": 300
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the teacher account is active and approved"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "uid",
        "email",
        "name",
        "nip",
        "role",
        "homeroomClass",
        "assignedSubjectIds",
        "assignedClasses",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "TeacherAssignment": {
      "title": "TeacherAssignment",
      "description": "Maps a teacher UID to a specific subject and class for a given academic year.",
      "type": "object",
